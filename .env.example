# Puerto del servidor
PORT=3000

# URL publica donde se ejecuta la app (se usa para armar los enlaces que
# reciben los tutores). En local puede quedar asi; si lo publicas cambia
# a tu dominio real, por ejemplo https://pisac.miescuela.edu
BASE_URL=http://localhost:3000

# Clave para firmar los tokens de sesion del profesor. CAMBIALA por una
# cadena larga y secreta antes de usar la app en produccion.
JWT_SECRET=cambia-esta-clave-por-una-muy-segura

# Cuanto dura la sesion del profesor (asi no tiene que volver a
# escribir su correo y contrasena). Ejemplos: 30d, 7d, 12h
SESSION_DURACION=30d

# Inicio de sesión con Google.
# Puedes dejarlo vacío: la app te pedirá el Client ID la primera vez que la
# abras y lo guardará en data/config.json (recomendado para uso local).
# Si lo pones aquí, tiene prioridad y no se podrá cambiar desde el panel.
GOOGLE_CLIENT_ID=

# URL publica para los enlaces que reciben los tutores.
# Si la dejas vacía, se puede configurar desde el panel: Ajustes > URL pública.
# Ejemplo con túnel: https://algo-random.trycloudflare.com

# Escala de calificaciones
NOTA_MAXIMA=100
NOTA_APROBATORIA=51

# Escala cualitativa (rangos sobre la nota maxima)
NIVEL_BUENO=71
NIVEL_EXCELENTE=91

# Ruta del archivo de base de datos (opcional)
# DB_PATH=./data/pisac.db

# Credenciales del profesor administrador que se crea la primera vez.
ADMIN_NOMBRE=Prof. Administrador
ADMIN_EMAIL=admin@pisac.edu
ADMIN_PASSWORD=admin123
